const ADMIN_ID = "135222778"; // il tuo Chat ID

export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    // Endpoint per GitHub Actions: elenco iscritti approvati
    if (url.pathname === "/subscribers" && request.method === "GET") {
      const key = url.searchParams.get("key");
      if (key !== env.API_KEY) {
        return new Response("Forbidden", { status: 403 });
      }
      const raw = (await env.SUBS.get("approved")) || "[]";
      return new Response(raw, {
        headers: { "content-type": "application/json" },
      });
    }

    // Webhook Telegram
    if (request.method === "POST") {
      const update = await request.json();
      const msg = update.message;
      if (!msg || !msg.text) return new Response("ok");

      const chatId = String(msg.chat.id);
      const text = (msg.text || "").trim();
      const nome =
        [msg.from?.first_name, msg.from?.last_name].filter(Boolean).join(" ") ||
        msg.from?.username ||
        "Sconosciuto";

      if (text === "/start") {
        await send(
          env,
          chatId,
          "👋 <b>Monitor Alto Adige</b>\n\n" +
            "Per ricevere le notifiche di allerta usa:\n" +
            "/iscriviti\n\n" +
            "Comandi:\n/iscriviti – richiedi l'iscrizione\n/stato – stato della tua richiesta\n/stop – disiscriviti"
        );
      } else if (text === "/iscriviti") {
        await handleIscriviti(env, chatId, nome);
      } else if (text === "/stato") {
        await handleStato(env, chatId);
      } else if (text === "/stop") {
        await handleStop(env, chatId);
      } else if (text.startsWith("/approva ") && chatId === ADMIN_ID) {
        const id = text.split(/\s+/)[1];
        await handleApprova(env, id);
      } else if (text.startsWith("/rifiuta ") && chatId === ADMIN_ID) {
        const id = text.split(/\s+/)[1];
        await handleRifiuta(env, id);
      } else if (text === "/lista" && chatId === ADMIN_ID) {
        await handleLista(env, chatId);
      } else {
        await send(env, chatId, "Comando non riconosciuto. Usa /start");
      }

      return new Response("ok");
    }

    return new Response("Monitor Alto Adige Bot");
  },
};

async function getList(env, key) {
  return JSON.parse((await env.SUBS.get(key)) || "[]");
}

async function setList(env, key, arr) {
  await env.SUBS.put(key, JSON.stringify(arr));
}

async function send(env, chatId, text) {
  await fetch(`https://api.telegram.org/bot${env.TELEGRAM_TOKEN}/sendMessage`, {
    method: "POST",
    headers: { "content-type": "application/json" },
    body: JSON.stringify({
      chat_id: chatId,
      text,
      parse_mode: "HTML",
    }),
  });
}

async function handleIscriviti(env, chatId, nome) {
  const approved = await getList(env, "approved");
  const pending = await getList(env, "pending");

  if (approved.find((u) => u.id === chatId)) {
    await send(env, chatId, "✅ Sei già iscritto alle notifiche.");
    return;
  }
  if (pending.find((u) => u.id === chatId)) {
    await send(env, chatId, "⏳ La tua richiesta è già in attesa di approvazione.");
    return;
  }

  pending.push({ id: chatId, nome, ts: new Date().toISOString() });
  await setList(env, "pending", pending);

  await send(env, chatId, "📨 Richiesta inviata.\nRiceverai conferma quando verrà approvata.");
  await send(
    env,
    ADMIN_ID,
    `🔔 <b>Nuova richiesta iscrizione</b>\n\n` +
      `Nome: <b>${nome}</b>\n` +
      `Chat ID: <code>${chatId}</code>\n\n` +
      `Per accettare:\n/approva ${chatId}\n\n` +
      `Per rifiutare:\n/rifiuta ${chatId}`
  );
}

async function handleStato(env, chatId) {
  const approved = await getList(env, "approved");
  const pending = await getList(env, "pending");
  if (approved.find((u) => u.id === chatId)) {
    await send(env, chatId, "✅ Stato: <b>iscritto</b> (ricevi le notifiche)");
  } else if (pending.find((u) => u.id === chatId)) {
    await send(env, chatId, "⏳ Stato: <b>in attesa</b> di approvazione");
  } else {
    await send(env, chatId, "❌ Stato: non iscritto. Usa /iscriviti");
  }
}

async function handleStop(env, chatId) {
  let approved = await getList(env, "approved");
  let pending = await getList(env, "pending");
  approved = approved.filter((u) => u.id !== chatId);
  pending = pending.filter((u) => u.id !== chatId);
  await setList(env, "approved", approved);
  await setList(env, "pending", pending);
  await send(env, chatId, "👋 Iscrizione rimossa. Non riceverai più notifiche.");
}

async function handleApprova(env, id) {
  let pending = await getList(env, "pending");
  let approved = await getList(env, "approved");
  const user = pending.find((u) => u.id === id);
  pending = pending.filter((u) => u.id !== id);
  if (!approved.find((u) => u.id === id)) {
    approved.push(user || { id, nome: "Utente", ts: new Date().toISOString() });
  }
  await setList(env, "pending", pending);
  await setList(env, "approved", approved);
  await send(env, ADMIN_ID, `✅ Approvato: <code>${id}</code>`);
  await send(env, id, "✅ La tua iscrizione è stata <b>approvata</b>.\nRiceverai le notifiche di allerta.");
}

async function handleRifiuta(env, id) {
  let pending = await getList(env, "pending");
  pending = pending.filter((u) => u.id !== id);
  await setList(env, "pending", pending);
  await send(env, ADMIN_ID, `❌ Rifiutato: <code>${id}</code>`);
  await send(env, id, "❌ La tua richiesta di iscrizione è stata rifiutata.");
}

async function handleLista(env, chatId) {
  const approved = await getList(env, "approved");
  const pending = await getList(env, "pending");
  let t = "<b>Iscritti approvati</b>\n";
  t += approved.length
    ? approved.map((u) => `• ${u.nome || "?"} (<code>${u.id}</code>)`).join("\n")
    : "Nessuno";
  t += "\n\n<b>In attesa</b>\n";
  t += pending.length
    ? pending.map((u) => `• ${u.nome || "?"} (<code>${u.id}</code>)`).join("\n")
    : "Nessuno";
  await send(env, chatId, t);
}
